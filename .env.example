# Copiad este fichero a .env (que NO se sube al repo) y rellenad sólo si usáis modo_plataformas: mcp
MODO_PLATAFORMAS=mock
# Correo al que el conserje avisa cuando escala un caso (p. ej. el Gmail del conserje).
# Con la dirección inventada de ejemplo, en modo mcp no se envía el aviso (sólo queda en logs/escalados.jsonl).
CORREO_ADMINISTRADOR=administracion@fincas-demo.es
# Microsoft (Outlook) — OPCIONAL: déjalo vacío para usar el registro de app que trae el servidor MCP.
# Sólo si falla, registrad una app en entra.microsoft.com y poned aquí su id.
MS365_MCP_CLIENT_ID=
# Google Calendar — credenciales OAuth "Desktop app"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_USER_EMAIL=conserje.demo@gmail.com
# Notion — token de la integración e id de la base "Incidencias"
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
