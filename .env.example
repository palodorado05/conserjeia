# Copiad este fichero a .env (que NO se sube al repo) y rellenad sólo si usáis modo_plataformas: mcp
MODO_PLATAFORMAS=mock
# Microsoft (Outlook) — id de la app registrada en entra.microsoft.com
MS365_MCP_CLIENT_ID=
# Google Calendar — credenciales OAuth "Desktop app"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_USER_EMAIL=conserje.demo@gmail.com
# Notion — token de la integración e id de la base "Incidencias"
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
